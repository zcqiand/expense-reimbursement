# 财务报销系统环境变量模板。
#
# 拷贝为 .env 之后填值；.env 已在 .gitignore 排除。
# 这里只列默认值；生产部署必须改 POSTGRES_PASSWORD。

# PostgreSQL 数据库
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense

# ---- agent sidecar（v2）----
# LLM_MODE 必填 mock|live，无默认兜底（fail-fast）
LLM_MODE=mock
# OpenAI 兼容端点（live 用）
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-M3
# 唯一 secret；mock 模式留空即可，live 必须填真实 key
LLM_API_KEY=
# agent 容器监听端口（compose 内固定 8100）
AGENT_PORT=8100
# Spring → sidecar 地址；compose 用容器名，dev 直跑 backend 用 http://127.0.0.1:8806
AGENT_BASE_URL=http://agent:8100
